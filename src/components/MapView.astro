---
/** Mapa escuro. Leaflet + OSM com tiles invertidos via CSS. */
export type Marker = { name: string; lat: number; lng: number; blurb?: string; kind?: 'base' | 'trabalho' | 'lugar' | 'rota'; href?: string; label?: string; chapter?: string };
interface Props {
  id: string;
  markers: Marker[];
  route?: { lat: number; lng: number }[];
  center: { lat: number; lng: number; zoom: number };
  fit?: boolean;
  animate?: boolean;
}
const { id, markers, route = [], center, fit = false, animate = false } = Astro.props;
---

<div class="map" id={id} data-markers={JSON.stringify(markers)} data-route={JSON.stringify(route)} data-center={JSON.stringify(center)} data-fit={String(fit)} data-animate={String(animate)} role="region" aria-label="Mapa interativo"></div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const mapsUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
  const accent = getComputedStyle(document.body).getPropertyValue('--accent').trim() || '#EDEAE3';

  document.querySelectorAll<HTMLElement>('.map[data-markers]').forEach((el) => {
    const markers = JSON.parse(el.dataset.markers || '[]');
    const route = JSON.parse(el.dataset.route || '[]');
    const center = JSON.parse(el.dataset.center || '{}');
    const fit = el.dataset.fit === 'true';
    const animate = el.dataset.animate === 'true';

    const map = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView([center.lat, center.lng], center.zoom);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19,
    }).addTo(map);

    const bounds: L.LatLngExpression[] = [];
    if (route.length > 1) {
      const pts = route.map((r: any) => [r.lat, r.lng] as [number, number]);
      const line = L.polyline(pts, { color: accent, weight: 1.6, dashArray: '3 7', opacity: 0.9 }).addTo(map);
      pts.forEach((p: any) => bounds.push(p));
      if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let i = 1; line.setLatLngs([pts[0]]);
        const step = () => { if (i >= pts.length) return; line.setLatLngs(pts.slice(0, i + 1)); i++; setTimeout(step, 280); };
        const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { step(); io.disconnect(); } }, { threshold: 0.3 });
        io.observe(el);
      }
    }
    markers.forEach((m: any) => {
      const kind = m.kind || 'lugar';
      const icon = L.divIcon({ html: `<div class="pin ${kind === 'base' ? 'base' : kind === 'trabalho' ? 'trabalho' : ''}"></div>`, className: '', iconSize: [14, 14], iconAnchor: [7, 7] });
      const mk = L.marker([m.lat, m.lng], { icon, title: m.name }).addTo(map);
      if (m.label) mk.bindTooltip(m.label, { permanent: true, direction: 'right', offset: [12, 0], className: 'pin-label' });
      mk.bindPopup(`<span class="tc">${m.chapter ? m.chapter + ' · ' : ''}${kind}</span><strong>${m.name}</strong>${m.blurb ? `<br><span>${m.blurb}</span>` : ''}<br><a href="${m.href || mapsUrl(m.name)}" target="_blank" rel="noopener">abrir no Google Maps ↗</a>`);
      bounds.push([m.lat, m.lng]);
    });
    if (fit && bounds.length > 1) map.fitBounds(L.latLngBounds(bounds), { padding: [40, 40] });
    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());
  });
</script>
