---
import BaseLayout from '../layouts/BaseLayout.astro';
import Frame from '../components/Frame.astro';
import type { ImageKey } from '../data/images';
import { u } from '../data/url';

const kit: { n: string; cat: string; name: string; poetic: string; functional: string; notes: string[]; img: ImageKey }[] = [
  { n: '01', cat: 'Câmera', name: 'Sony A7V', img: 'kitCamera', poetic: 'A câmera que tenta não chamar atenção. Boa para rua, boa para canto escuro, boa para fingir que eu estava só passando por ali.', functional: 'Corpo principal. Full-frame, ISO alto, 4K, estabilização suficiente para caminhada sem virar operação de gimbal.', notes: ['Primeira viagem internacional dela, e a primeira vez que trabalha fora do país: Gallery FUMI em Londres e Sorgin Gallery em San Sebastián.', 'Obturador silencioso por padrão. Em Borough Market e na Parte Vieja, ninguém precisa saber que virou cena.'] },
  { n: '02', cat: 'Lente', name: 'Sony FE 24-70mm f/2.8 GM', img: 'kitLente', poetic: 'A lente da rua. Não é a mais poética da mochila, mas é a que salva o dia quando a viagem resolve andar mais rápido que o roteiro.', functional: 'Zoom standard para resolver 90% da vida real: rua, paisagem, retrato médio, detalhe, café, pub, estação, fachada.', notes: ['Vai morar no corpo da câmera durante quase toda a viagem.', 'Nas galerias, é a lente das peças: ampla o suficiente para o espaço, fechada o suficiente para o detalhe da madeira.'] },
  { n: '03', cat: 'Lente', name: 'Sony FE 50mm f/1.2 GM', img: 'kitLente', poetic: 'A lente do silêncio. Quando sai da mochila, é porque alguém ou alguma coisa merece mais atenção do que cobertura.', functional: 'Prime de retrato. f/1.2 para luz difícil, separação de plano e aquela profundidade que parece exagero até aparecer no monitor.', notes: ['Reservada para retrato: Max Lamb, Miriam Badaró, Hugo no pub.', 'Vai sair pouco. Por isso, quando sair, precisa importar.'] },
  { n: '04', cat: 'Action cam', name: 'Insta360 Ace Pro 2', img: 'kitCamera', poetic: 'A câmera do gesto. Cabe na mão fechada, entra rápido, sai rápido e não atrapalha a caminhada.', functional: 'Action cam compacta, estabilizada, feita para registrar movimento sem montar cerimônia.', notes: ['Chegada em estação, fila do jogo, AP-8 pela janela do carro, trilha do Areeiro.', 'Em Madeira, pode ser a câmera que salva a trilha quando a mochila técnica virar inimiga pessoal.'] },
  { n: '05', cat: 'Drone', name: 'DJI Mini 3 Pro', img: 'kitDrone', poetic: 'O olho de cima, com a obrigação moral de saber a hora de ficar guardado.', functional: 'Abaixo de 250 g, câmera 4K, baterias para voos curtos. Registro em CAA (Reino Unido), AESA (Espanha) e ANAC (Portugal).', notes: ['Não voa em Londres nem em Manchester. Cidade grande já é complicada o bastante.', 'Em Madeira, voa pouco e bem: Cabo Girão, Ponta de São Lourenço, talvez Fanal quando a neblina abrir.', 'Curral das Freiras fica fora. Respeito também é direção.'] },
  { n: '06', cat: 'Analógica', name: 'Olympus Trip 35', img: 'kitAnalogica', poetic: 'Uma câmera simples o suficiente para lembrar que fotografia também pode ser aposta.', functional: '35mm compacta, lente fixa 40mm f/2.8 Zuiko, fotômetro de selênio, foco por zona e zero vontade de facilitar demais.', notes: ['San Sebastián é o território dela agora que Lisboa saiu. Portra 400, poucas poses, nenhuma revisão na tela.', 'Trinta e seis frames em três noites. O que sair, sai.'] },
  { n: '07', cat: 'Super 8', name: 'Canon Auto Zoom 814', img: 'kitSuper8', poetic: 'A textura que o digital imita bem até você ver o grão verdadeiro mexendo como bicho vivo.', functional: 'Zoom 7.5 a 60mm f/1.4, rolos de 50 pés, cerca de 3,5 minutos por cartucho a 18 fps.', notes: ['Sai na Madeira. Três rolos de Kodak Vision3 50D, cerca de dez minutos totais de filme bruto.', 'Fanal é a cena principal. Trinta segundos, mão firme, sem zoom de tiozão.', 'Revelação só no Brasil. Seis semanas sem saber se deu certo. Uma crueldade bonita.'] },
];
---

<BaseLayout title="Kit" description="O equipamento como elenco, não inventário. Sony A7V, duas G Master, Insta360, DJI Mini, Olympus Trip 35 e uma Canon Super 8." current={u('/kit')}>
  <header class="wrap section" style="padding-bottom:2rem">
    <p class="tc">equipamento · lista de câmera</p>
    <h1 class="t-hero" style="margin-top:.6rem">Elenco<span class="accent">,</span><br />não inventário.</h1>
    <p class="t-lead" style="max-width:56ch; margin-top:2rem">Como todo elenco, tem protagonista, coadjuvante caro, peça temperamental e equipamento que talvez passe mais tempo na mochila do que em cena. Esta página é a ficha técnica dessa teimosia.</p>
  </header>

  <section class="wrap">
    <ol>
      {kit.map((k, i) => (
        <li class:list={['ki', { alt: i % 2 === 1 }]}>
          <div class="ki__pic rv"><Frame k={k.img} ratio="43" tl={`ITEM ${k.n}`} tr={k.cat.toUpperCase()} caption="" /></div>
          <div class="ki__text rv-f">
            <p class="tc"><span class="on">{k.n}</span> · {k.cat}</p>
            <h2 class="t-xl" style="margin-top:.5rem; font-size:clamp(2rem,4.5vw,4rem)">{k.name}</h2>
            <p class="t-lead" style="margin-top:1.2rem; max-width:40ch; color:var(--text)">{k.poetic}</p>
            <p class="muted" style="margin-top:1.2rem; max-width:52ch">{k.functional}</p>
            <ul class="ki__notes">{k.notes.map((n) => <li>→ {n}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section">
    <div class="box">
      <p class="tc" style="margin-bottom:1.2rem">logística do kit · setembro 2026</p>
      <div class="box__grid">
        <div><strong>≈ R$ 65.000</strong><br /><span class="muted">valor do kit, cinco vezes acima do gatilho de US$ 2.000 da Receita</span></div>
        <div><strong>e-DBV de saída</strong><br /><span class="muted">gratuita, prova posse anterior à viagem. Carimbo em GRU no dia 16/10</span></div>
        <div><strong>9,7 kg</strong><br /><span class="muted">mochila PGYTECH cheia. Limite de mão na TAP: 10 kg. Pesar em casa</span></div>
        <div><strong>3 registros de drone</strong><br /><span class="muted">CAA Reino Unido, AESA Espanha, ANAC Portugal</span></div>
        <div><strong>Filme pede raio X manual</strong><br /><span class="muted">Portra 400 e Vision3 50D: inspeção à mão nos quatro aeroportos</span></div>
        <div><strong>Seguro com equipamento</strong><br /><span class="muted">mínimo R$ 100 mil, obrigatório numa viagem que virou de trabalho</span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ki { display: grid; gap: 2rem; padding-block: 3rem; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .ki { grid-template-columns: 5fr 7fr; gap: 4rem; align-items: center; } .ki.alt .ki__pic { order: 2; } }
  .ki__notes { margin-top: 1.5rem; display: grid; gap: 0.5rem; max-width: 56ch; font-size: 0.95rem; color: var(--text-2); }
  .box { border: 1px solid var(--line-strong); padding: 2rem; background: var(--panel); }
  .box__grid { display: grid; gap: 1.5rem; }
  @media (min-width: 800px) { .box__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
